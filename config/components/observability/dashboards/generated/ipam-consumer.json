               "expr": "histogram_quantile(0.95,\n  sum by (le, namespace, resource) (rate(apiserver_request_duration_seconds_bucket{job=\"$job\", instance=~\"$instance\", namespace=~\"$namespace\", resource=~\"$resource\", verb=\"create\"}[5m]))\n)\n",
               "legendFormat": "{{namespace}} / {{resource}}"
            }
