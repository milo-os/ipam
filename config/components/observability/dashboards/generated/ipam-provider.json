         "type": "gauge"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "Highest-utilization pools right now.",
         "fieldConfig": {
            "defaults": {
               "unit": "percentunit"
